# Offline, local-only test profile. All outputs are synthetic; no external API calls are made.
DEMO_MODE=true

# Admin panel credentials for local testing (replace with strong credentials in production)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=123

# Phase 6: Demo SMS OTP and instant demo checkout
SMS_PROVIDER=demo
PAYMENT_PROVIDER=demo
OTP_RESEND_SECONDS=5

# Placeholder values: demo mode bypasses these provider clients.
LLM_BASE_URL=http://127.0.0.1:9/v1
LLM_API_KEY=demo-not-a-secret
VISION_MODEL_A=demo-vision-a
VISION_MODEL_B=demo-vision-b
VISION_MODEL_PRIMARY=demo-vision
TUTOR_MODEL=demo-tutor
SPEECH_TO_TEXT_MODEL=demo-speech

# SQLite is created automatically in the backend directory; no Docker required.
DATABASE_URL=sqlite+aiosqlite:///./demo.sqlite3

# Used only by non-demo indexing settings.
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=iran_textbooks_demo
EMBEDDING_MODEL=demo-embedding
EMBEDDING_DIMENSION=64

# Phase 1: demo key-vault material (encrypts provider API keys at rest)
SECRET_KEY=demo-secret-key-change-me
RATE_LIMIT_ENABLED=true
# REDIS_URL is optional; without it the in-process limiter is used.
