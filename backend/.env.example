# Copy this file to `backend/.env` and set real values. Never commit `.env`.

# --- LLM provider (OpenAI-compatible API) ---
LLM_BASE_URL=
LLM_API_KEY=

# --- Vision models to compare (compare script only) ---
VISION_MODEL_A=
VISION_MODEL_B=

# --- Production ingestion models ---
VISION_MODEL_PRIMARY=
VISION_MODEL_ESCALATION=
TUTOR_MODEL=
# Optional: use an OpenAI-compatible transcription provider for voice questions.
SPEECH_TO_TEXT_MODEL=
AUDIO_BASE_URL=
AUDIO_API_KEY=
ESCALATE_FIGURES=false

# --- Client behaviour ---
LLM_TIMEOUT=120
MAX_CONCURRENCY=3

# --- Admin panel authentication (change to strong credentials in production) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=123

# --- Phase 6: Student SMS OTP auth & payment providers ---
# Generate a long random string for AUTH_SECRET in production.
AUTH_SECRET=
USER_SESSION_TTL_SECONDS=2592000
OTP_TTL_SECONDS=180
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
# SMS_PROVIDER: demo | kavenegar | sms_ir | webhook
SMS_PROVIDER=demo
SMS_API_KEY=
SMS_SENDER=
SMS_TEMPLATE=
SMS_WEBHOOK_URL=
# PAYMENT_PROVIDER: demo | zarinpal
PAYMENT_PROVIDER=demo
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=false
PUBLIC_APP_URL=http://localhost:3000

# --- PostgreSQL (local Docker or Supabase) ---
DATABASE_URL=postgresql+asyncpg://iran_tutor:change_me@127.0.0.1:5432/iran_tutor

# --- Phase 2: vector retrieval ("qdrant" or "pgvector" for Supabase) ---
VECTOR_BACKEND=qdrant
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=iran_textbooks
# Leave embedding base URL/key empty to reuse LLM_BASE_URL and LLM_API_KEY.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# Phase 1: master key material for the encrypted AI-provider vault.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Phase 1: Redis (sliding-window rate limiting). Leave empty to use the in-process limiter.
REDIS_URL=redis://127.0.0.1:6379/0
RATE_LIMIT_ENABLED=true
